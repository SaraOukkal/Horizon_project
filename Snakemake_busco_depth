import pandas as pd
import re
import os

#Your paths
Genomes_dir="/beegfs/project/horizon/data/assembly/species/"
Output_dir="/beegfs/project/horizon/data/mapping/"
Scripts_dir="/beegfs/data/soukkal/Thesis/Horizon/Scripts"
logs_dir="/beegfs/data/soukkal/Thesis/Horizon/Mapping/logs/"

#Softwares :
Soft_dir="/beegfs/home/soukkal/miniconda3/bin/"

Genome_IDS_table=pd.read_csv("/beegfs/data/soukkal/Thesis/Horizon/species_list_236.txt",header=None)
list_Genome_IDs=list(Genome_IDS_table[0])

#This rule contains all the expected output from all your rules within the snakefile
rule all:
        input:
                expand(Output_dir+"BUSCO_depth/BUSCO_{Genome_ID}_sp1.per-base.bed", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"BUSCO_depth/BUSCO_{Genome_ID}_sp2.per-base.bed", Genome_ID = list_Genome_IDs)

rule Depth_Sp1:
        params:
                threads="8",
                partition="normal",
                time="24:00:00",
                mem="8G",
                name="Depth_S1_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_depth_S1.out",
                err=logs_dir+"{Genome_ID}_depth_S1.error"
        input:
                BAM_1=Output_dir+"bam/{Genome_ID}_sp1.bam.gz",
                BED_1="/beegfs/project/horizon/data/stats/busco/species_busco_pos/Busco_positions_{Genome_ID}_sp1.bed"
        output:
                BED_2=Output_dir+"BUSCO_depth/BUSCO_{Genome_ID}_sp1.per-base.bed"
        shell:
                """
                {Soft_dir}samtools sort {input.BAM_1} -l 1 -o {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted.bam.gz
                {Soft_dir}samtools depth -a {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted.bam.gz -b {input.BED_1} > {output.BED_2}
                rm {Output_dir}bam/{wildcards.Genome_ID}_sp1_sorted.bam.gz
                """

rule Depth_Sp2:
        params:
                threads="8",
                partition="normal",
                time="24:00:00",
                mem="8G",
                name="Depth_S2_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_depth_S2.out",
                err=logs_dir+"{Genome_ID}_depth_S2.error"
        input:
                BAM_2=Output_dir+"bam/{Genome_ID}_sp2.bam.gz",
                BED_3="/beegfs/project/horizon/data/stats/busco/species_busco_pos/Busco_positions_{Genome_ID}_sp1.bed"
        output:
                BED_4=Output_dir+"BUSCO_depth/BUSCO_{Genome_ID}_sp2.per-base.bed"
        shell:
                """
                {Soft_dir}samtools sort {input.BAM_2} -l 1 -o {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted.bam.gz
                {Soft_dir}samtools depth -a {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted.bam.gz -b {input.BED_3} > {output.BED_4}
                rm {Output_dir}bam/{wildcards.Genome_ID}_sp2_sorted.bam.gz
                """

