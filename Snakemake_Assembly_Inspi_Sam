#This rule contains all the expected output from all your rules within the snakefile 
rule all:
        input:
                expand(Output_dir+"{Genome_ID}/reads_1.trim.fq.gz", Genome_ID = list_Genome_IDs), 
                expand(Output_dir+"{Genome_ID}/reads_2.trim.fq.gz", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"{Genome_ID}/Assembly/assembly.contigs.fa.gz", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"{Genome_ID}/Assembly/assembly.contigs.fa", Genome_ID = list_Genome_IDs),
                expand(Output_dir+"{Genome_ID}/Assembly/scaffolds.reduced.fa.gz", Genome_ID = list_Genome_IDs)

                
#Trmming : retrait des bases et reads de mauvaise qualité et nettoyage des séquences d'adaptateurs : 
rule Trimming:
        params:
                threads="16",
                partition="normal",
                time="01:00:00",
                mem="4096M", 
                name="Trimming_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_trim.out",
                err=logs_dir+"{Genome_ID}_trim.error",
                html = logs_dir+"{Genome_ID}_trim.html",
                json = logs_dir+"{Genome_ID}_trim.json"
        input:
                R1=Reads_dir+"{Genome_ID}_1.fastq.gz",
                R2=Reads_dir+"{Genome_ID}_2.fastq.gz"
        output:
                R1=Output_dir+"{Genome_ID}/reads_1.trim.fq.gz",
                R2=Output_dir+"{Genome_ID}/reads_2.trim.fq.gz"
        shell:
                """
                fastp --thread {params.threads} --in1 {input.R1} --in2 {input.R2} --out1 {output.R1} --out2 {output.R2} --adapter_sequence AGATCGGAAGAGCACACGTCTGAACTCCAGTCA --adapter_sequence_r2 AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT --length_required 100 --correction --json {params.json} --html {params.html} 2> {params.err} > {params.out}
                """ 

