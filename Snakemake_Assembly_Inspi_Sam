#Assemblage des reads avec Megahit (la ça utilise les résultats direct du trimming sans concaténation, changer s'il faut concaténer): 
rule assembly:
        params:
                threads="8",
                partition="bigmem",
                time="30:00:00",
                mem="96G",
                name="Assembly_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_Assembly.out",
                err=logs_dir+"{Genome_ID}_Assembly.error"
        input:
                R1=Output_dir+"{Genome_ID}/reads_1.trim.fq.gz",
                R2=Output_dir+"{Genome_ID}/reads_2.trim.fq.gz"
        output:
                Assembly=Output_dir+"{Genome_ID}/Assembly/assembly.contigs.fa.gz"
        conda: 
                megahit
        shell: 
                """
                {Scripts_dir}/run_megahit.sh -s {wildcards.Genome_ID} -1 {input.R1} -2 ${input.R2} -c {params.threads} -m 49 -S
                """

#Renommer les headers des séquences pour que ce soit lu correctement par le logiciel de scaffolding : 
rule contig_rehead: 
        params:
                threads="2",
                partition="normal",
                time="00:30:00",
                mem="2000M",
                name="Rehead_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_contig_rehead.out",
                err=logs_dir+"{Genome_ID}_contig_rehead.error"
        input:
                Assembly=Output_dir+"{Genome_ID}/Assembly/assembly.contigs.fa.gz"
        output:
                Assembly2=Output_dir+"{Genome_ID}/Assembly/assembly.contigs.fa"
        shell:
                """
                gzip -d -c {input.Assembly} | {Scripts_dir}/annotate_contigs.pl {wildcards.Genome_ID} > {output.Assembly2}
                """

#Scaffolding (regrouper les contigs grace aux information des reads paired end)
rule scaffolding:
        params:
                threads="16",
                partition="normal",
                time="24:00:00",
                mem="32G",  ######Mettre BIG MEM ???
                name="Scaffolding_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_scaffolding.out",
                err=logs_dir+"{Genome_ID}_scaffolding.error"
        input:
                Assembly=Output_dir+"{Genome_ID}/Assembly/assembly.contigs.fa",
                R1=Output_dir+"{Genome_ID}/reads_1.trim.fq.gz",
                R2=Output_dir+"{Genome_ID}/reads_2.trim.fq.gz"
        output:
                Assembly2=Output_dir+"{Genome_ID}/Assembly/scaffolds.reduced.fa.gz"
        conda: 
                redundans
        shell: ##Les inputs et outputs sont à spécifier directement dans le script
                """
                {Scripts_dir}/run_redundans_2.sh --sample {wildcards.Genome_ID} --cpus {params.threads}
                """

#Renommer les noms des headers des scaffolds : 
rule scaffold_rehead:
        params:
                threads="1",
                partition="normal",
                time="00:30:00",
                mem="2000M",
                name="Rehead_{Genome_ID}",
                out=logs_dir+"{Genome_ID}_scaff_rehead.out",
                err=logs_dir+"{Genome_ID}_scaff_rehead.error"
        input:
                Assembly=Output_dir+"{Genome_ID}/Assembly/scaffolds.reduced.fa.gz"
        output:
                Assembly2=Output_dir+"{Genome_ID}/Assembly/scaffolds.hdr.fa"
        shell:
                """
                gzip -d -c {input.Assembly} | {Scripts_dir}/annotate_contigs.pl {wildcards.Genome_ID} > {output.Assembly2}
                """
