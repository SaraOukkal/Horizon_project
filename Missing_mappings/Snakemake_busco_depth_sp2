import pandas as pd
import re
import os

#Your paths
Genomes_dir="/beegfs/project/horizon/data/assembly/species/"
Output_dir="/beegfs/project/horizon/data/mapping/"
Scripts_dir="/beegfs/data/soukkal/Thesis/Horizon/Scripts/Missing_mappings/"
logs_dir="/beegfs/data/soukkal/Thesis/Horizon/Mapping/logs/"

#Softwares :
Soft_dir="/beegfs/home/soukkal/miniconda3/bin/"

##Créer un dictionnaire avec les correspondances species et specimens : 

file_names = [
    "mylon_lassia:04-SRNP-48829",
    "geljanzen01_janzen180:02-SRNP-3724",
    "lixophaga_wood06:DHJPAR0011714",
    "actia_janzen06:DHJPAR0050715",
]

species_to_specimen={}

for file_name in file_names:
    parts = file_name.split(':')
    if len(parts) == 2:
        species, specimen = parts
        species_to_specimen[species] = specimen

#This rule contains all the expected output from all your rules within the snakefile
rule all:
        input:
                [f"{Output_dir}BUSCO_depth/BUSCO_{key}:{value}.per-base.bed" for key, value in species_to_specimen.items()]

rule Depth:
        params:
                threads="8",
                partition="normal",
                time="24:00:00",
                mem="8G",
                name="Depth_{sample}_2",
                out=logs_dir+"{sample}_depth_sp2.out",
                err=logs_dir+"{sample}_depth_sp2.error",
                sample_value=lambda wildcards: species_to_specimen[wildcards.sample],
                sample=lambda wildcards: wildcards.sample
        input:
                BAM_1=Output_dir+"bam/{sample}:{sample_value}.bam.gz",
                BED_1="/beegfs/project/horizon/data/stats/busco/species_busco_pos/Busco_positions_{sample}_{sample_value}_modified.bed"
        output:
                BED_2=Output_dir+"BUSCO_depth/BUSCO_{sample}:{sample_value}.per-base.bed"
        shell:
                """
                {Soft_dir}samtools sort {input.BAM_1} -l 1 -o {Output_dir}bam/{params.sample}:{params.sample_value}_sorted.bam.gz
                {Soft_dir}samtools depth -a {Output_dir}bam/{params.sample}:{params.sample_value}_sorted.bam.gz -b {input.BED_1} > {output.BED_2}
                rm {Output_dir}bam/{params.sample}:{params.sample_value}_sorted.bam.gz
                """
