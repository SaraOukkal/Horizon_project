#Your paths
Genomes_path="/beegfs/project/horizon/data/assembly/specimens/"
Output_dir="/beegfs/project/horizon/data/stats/busco/specimens/"
Logs_dir="/beegfs/data/soukkal/Thesis/Horizon/BUSCO/logs/"

#Open species list : 
Genome_IDS_table=pd.read_csv("/beegfs/data/soukkal/Thesis/Horizon/specimens_list_1.txt",header=None)
list_Genome_IDs=list(Genome_IDS_table[0])

rule all:
  input:
        expand(Output_dir+"{Genome_ID}/run_insecta_odb10/full_table.tsv", Genome_ID = list_Genome_IDs)

#Run BUSCO analysis:
rule BUSCO:
  params:
     threads="12",
     time="24:00:00",
     mem="12G",
     name="BUSCO_{Genome_ID}",
     out=Logs_dir+"{Genome_ID}_BUSCO.out",
     err=Logs_dir+"{Genome_ID}_BUSCO.error",
     lineage="/beegfs/project/horizon/data/stats/busco/species/busco_downloads/lineages/insecta_odb10",
     mode="genome"
  input:
     Assembly=Genomes_path+"{Genome_ID}/redundans/scaffolds.reduced.fa"
  output:
     BUSCO_result=Output_dir+"{Genome_ID}/run_insecta_odb10/full_table.tsv"
  shell:
     """
      hostname
      cd /beegfs/project/horizon/data/stats/busco/specimens/
      /beegfs/data/soft/singularity-3.7.2/bin/singularity exec --bind /beegfs/:/beegfs/ /beegfs/data/soukkal/TOOLS/BUSCO.sif busco -i {Genomes_path}{wildcards.Genome_ID}/redundans/scaffolds.reduced.fa -l {params.lineage} -m {params.mode} -o {wildcards.Genome_ID}/ -c 3 -f
     """
